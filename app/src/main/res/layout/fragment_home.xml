<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" layout_width="match_parent" layout_height="match_parent" fillViewport="true" background="@color/canvas" xmlns:app="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/greeting" android:text="" android:textSize="28sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
    <TextView android:id="@+id/subtitle" android:text="@home_subtitle" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/notifications" android:text="@notifications_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.TonalButton" />
    <TextView android:id="@+id/groupHeading" android:text="@home_your_groups" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:paddingTop="24dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/groups" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:paddingTop="12dp" />
    <TextView android:id="@+id/empty" android:text="@home_empty_body" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
      <com.google.android.material.button.MaterialButton android:id="@+id/create" android:text="@action_create_group" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button" android:layout_weight="1" android:layout_marginEnd="6dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/join" android:text="@action_join_group" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button" android:layout_weight="1" android:layout_marginEnd="6dp" />
    </LinearLayout>
    <TextView android:id="@+id/quickHeading" android:text="@home_quick_start" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:paddingTop="24dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/decide" android:text="@home_cant_decide" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/surprise" android:text="@home_surprise_me" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/activities" android:text="@home_my_activities" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
  </LinearLayout>
</ScrollView>