<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/canvas">
  <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/round" android:text="" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/participation" android:text="" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" />
    <TextView android:id="@+id/icon" android:text="" android:textSize="64sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="30dp" />
    <TextView android:id="@+id/title" android:text="" android:textSize="26sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:gravity="center" android:paddingTop="12dp" />
    <TextView android:id="@+id/body" android:text="" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="16dp" android:lineSpacingExtra="4dp" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp">
      <com.google.android.material.button.MaterialButton android:id="@+id/no" android:text="@string/action_no" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button" android:layout_weight="1" android:layout_marginEnd="6dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/yes" android:text="@string/action_yes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button" android:layout_weight="1" android:layout_marginEnd="6dp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/primary" android:text="@string/action_done" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button" />
    <com.google.android.material.button.MaterialButton android:id="@+id/secondary" android:text="@string/decision_close_round" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
  </LinearLayout>
</ScrollView>