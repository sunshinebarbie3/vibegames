<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" layout_width="match_parent" layout_height="match_parent" fillViewport="true" background="@color/canvas" xmlns:app="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/subtitle" android:text="@settings_subtitle" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/notifications" android:text="@settings_notifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingTop="12dp" />
    <TextView android:id="@+id/notificationsDetail" android:text="@settings_notifications_detail" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/privacy" android:text="@settings_privacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingTop="12dp" />
    <TextView android:id="@+id/privacyDetail" android:text="@settings_privacy_members" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/themeLabel" android:text="@settings_theme" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:paddingTop="24dp" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/themes" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/syncStatus" android:text="" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/sync" android:text="@settings_sync_now" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/conflicts" android:text="@settings_open_conflicts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/failed" android:text="@settings_failed_changes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/language" android:text="@settings_language" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/password" android:text="@settings_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/linkGoogle" android:text="@settings_linked_google" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/editProfile" android:text="@profile_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/deleteAccount" android:text="@settings_delete_account" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton android:id="@+id/logout" android:text="@settings_sign_out" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button.OutlinedButton" />
  </LinearLayout>
</ScrollView>