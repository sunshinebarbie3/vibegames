<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" layout_width="match_parent" layout_height="match_parent" fillViewport="true" background="@color/canvas" xmlns:app="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:src="@drawable/ic_vibe_logo" android:contentDescription="@cd_logo" android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center" android:layout_marginTop="28dp" />
    <TextView android:id="@+id/brand" android:text="@VIBE" android:textSize="48sp" android:textColor="@color/vibe_coral" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" />
    <TextView android:id="@+id/tagline" android:text="@string/onboarding_tagline" android:textSize="24sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="8dp" />
    <TextView android:id="@+id/step1" android:text="@string/onboarding_step1" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp" android:lineSpacingExtra="4dp" />
    <TextView android:id="@+id/step2" android:text="@string/onboarding_step2" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp" android:lineSpacingExtra="4dp" />
    <TextView android:id="@+id/step3" android:text="@string/onboarding_step3" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp" android:lineSpacingExtra="4dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/primary" android:text="@action_get_started" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="Widget.Material3.Button" />
  </LinearLayout>
</ScrollView>