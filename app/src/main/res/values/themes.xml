<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.VIBE" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vibe_coral</item>
        <item name="colorOnPrimary">@color/action_ink</item>
        <item name="colorPrimaryContainer">@color/vibe_coral_soft</item>
        <item name="colorSecondary">@color/vibe_lilac</item>
        <item name="colorTertiary">@color/vibe_mint</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Vibe.Button</item>
        <item name="textInputStyle">@style/Vibe.Input</item>
    </style>
    <style name="Theme.VIBE" parent="Base.Theme.VIBE" />
    <style name="Theme.VIBE.Splash" parent="Theme.VIBE" />
    <style name="Vibe.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
    </style>
    <style name="Vibe.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
    <style name="Vibe.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">18dp</item>
    </style>
    <style name="Vibe.Title"><item name="android:textSize">26sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text_primary</item></style>
    <style name="Vibe.Body"><item name="android:textSize">16sp</item><item name="android:lineSpacingExtra">4dp</item><item name="android:textColor">@color/text_secondary</item></style>
</resources>
