{
  "name": "vibe-firebase-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/app.js && node --check src/store.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "file-type": "21.1.1",
    "firebase-admin": "13.6.0",
    "google-auth-library": "10.5.0",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "zod": "4.1.12"
  }
}
