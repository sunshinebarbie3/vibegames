# Copy to server/.env. Never commit credentials or put admin credentials in Android.
PORT=8080
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_STORAGE_BUCKET=
GOOGLE_SERVER_CLIENT_ID=
# Use Application Default Credentials locally (gcloud auth application-default login),
# or a Cloud Run service account in production. No JSON key needs to be committed.
GOOGLE_APPLICATION_CREDENTIALS=
# Set to 1 only behind your HTTPS reverse proxy.
TRUST_PROXY=1
# Optional browser origins; the Android client does not require CORS.
ALLOWED_ORIGIN=
