rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: the requesting user's UID.
    function uid() {
      return request.auth.uid;
    }

    // Helper: is the user a member of the given group?
    function isMember(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          .hasAny([uid()]);
    }

    // Helper: is the user the owner of the given group?
    function isOwner(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == uid();
    }

    // ------------------------------------------------------------------ users

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && userId == uid();
      allow update: if isSignedIn() && userId == uid();
      allow delete: if false; // Account deletion is handled by Firebase Auth.
    }

    // ------------------------------------------------------------------ groups

    match /groups/{groupId} {
      allow read: if isSignedIn() && uid() in resource.data.memberIds;
      allow create: if isSignedIn();
      allow update: if isOwner(groupId) || (isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','memberIds']) &&
        request.resource.data.memberIds == (uid() in resource.data.memberIds ? resource.data.memberIds : resource.data.memberIds.concat([uid()])) &&
        request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid()]) &&
        request.resource.data.members[uid()].keys().hasOnly(['invite', 'displayName']) &&
        request.resource.data.members[uid()].invite == resource.data.inviteCode &&
        get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.groupId == groupId);
      allow delete: if isOwner(groupId);
    }

    // Invite code lookup: read-only for anyone who knows the code.
    match /invites/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == uid() &&
        getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;
    }

    // ------------------------------------------------------------------ activities

    match /activities/{activityId} {
      allow read: if isSignedIn() && isMember(resource.data.groupId);
      allow create: if isSignedIn() && isMember(request.resource.data.groupId);
      allow update: if isSignedIn() && isMember(resource.data.groupId) &&
        (request.auth.uid == resource.data.createdBy || isOwner(resource.data.groupId));
      allow delete: if isSignedIn() && isMember(resource.data.groupId) &&
        (request.auth.uid == resource.data.createdBy || isOwner(resource.data.groupId));
    }

    // ------------------------------------------------------------------ decisions

    match /decisions/{decisionId} {
      allow read: if isSignedIn() && isMember(resource.data.groupId);
      allow create: if isSignedIn() && isOwner(request.resource.data.groupId);
      allow update: if isSignedIn() && isOwner(resource.data.groupId);
      allow delete: if false;
    }

    // ------------------------------------------------------------------ votes

    // Vote document IDs are predictable: {decisionId}:{activityId}:{userId}.
    // This lets us enforce one vote per member per idea and prevent voting
    // on someone else's behalf.
    match /votes/{voteId} {
      function round(id) { return get(/databases/$(database)/documents/decisions/$(id)).data; }
      allow read: if isSignedIn() && isMember(round(resource.data.decisionId).groupId) &&
        (resource.data.userId == uid() || (isOwner(round(resource.data.decisionId).groupId) && round(resource.data.decisionId).get('acceptingVotes', true) == false) || round(resource.data.decisionId).state != 'OPEN');
      allow create, update: if isSignedIn() && request.resource.data.userId == uid() &&
        voteId == request.resource.data.decisionId + ':' + request.resource.data.activityId + ':' + uid() &&
        isMember(round(request.resource.data.decisionId).groupId) && round(request.resource.data.decisionId).state == 'OPEN' &&
        round(request.resource.data.decisionId).get('acceptingVotes', true) && request.resource.data.activityId in round(request.resource.data.decisionId).activityIds &&
        request.resource.data.choice is bool;
    }

    match /decisions/{id}/participation/{user} {
      function round() { return get(/databases/$(database)/documents/decisions/$(id)).data; }
      function valid(old) {
        let idea = request.resource.data.latest;
        let ballot = id + ':' + idea + ':' + user;
        return user == uid() && isMember(round().groupId) && round().state == 'OPEN' &&
          idea in round().activityIds && request.resource.data.keys().hasOnly(['latest','activities']) &&
          request.resource.data.activities == (idea in old ? old : old.concat([idea])) &&
          getAfter(/databases/$(database)/documents/votes/$(ballot)).data.userId == user;
      }
      allow read: if isMember(round().groupId);
      allow create: if isSignedIn() && valid([]);
      allow update: if isSignedIn() && valid(resource.data.activities);
    }

    // ------------------------------------------------------------------ plans

    match /plans/{planId} {
      allow read: if isSignedIn() && isMember(resource.data.groupId);
      allow create: if isSignedIn() && isMember(request.resource.data.groupId);
      allow update: if isSignedIn() && isMember(resource.data.groupId);
      allow delete: if false;
    }

    // ------------------------------------------------------------------ memories

    match /memories/{memoryId} {
      allow read: if isSignedIn() && isMember(resource.data.groupId);
      allow create: if isSignedIn() && isMember(request.resource.data.groupId);
      allow update: if isSignedIn() && isMember(resource.data.groupId) &&
        request.auth.uid == resource.data.createdBy;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ notifications

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if false;
    }

    // ------------------------------------------------------------------ devices (FCM tokens)

    match /devices/{deviceId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }
  }
}
